msgid "Required for API requests"
msgstr "API istekleri için gerekli"

#: public/views/wc-settings/shipink-page.php:110
msgid "SSL (HTTPS)"
msgstr "SSL (HTTPS)"

#: public/views/wc-settings/shipink-page.php:111
msgid "Enabled"
msgstr "Etkin"

#: public/views/wc-settings/shipink-page.php:111
msgid "Disabled"
msgstr "Kapalı"

#: public/views/wc-settings/shipink-page.php:113
msgid "Recommended for secure webhook delivery"
msgstr "Güvenli webhook teslimi için önerilir"

#: public/views/wc-settings/shipink-page.php:118
msgid "Permalinks"
msgstr "Kalıcı Bağlantılar"

#: public/views/wc-settings/shipink-page.php:119
msgid "Pretty"
msgstr "Düzgün"

#: public/views/wc-settings/shipink-page.php:119
msgid "Plain"
msgstr "Sade"

#: public/views/wc-settings/shipink-page.php:121
msgid "Plain permalinks can break webhooks. Settings → Permalinks"
msgstr "Sade kalıcı bağlantılar webhookları bozabilir. Ayarlar → Kalıcı Bağlantılar"

